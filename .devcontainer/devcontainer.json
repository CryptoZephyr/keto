{
  "name": "Keto",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true
    }
  },
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "npm install",
  "forwardPorts": [],
  "portsAttributes": {
    "7687": { "visibility": "private" },
    "8443": { "visibility": "private" },
    "9090": { "visibility": "private" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  },
  "remoteEnv": {
    "HYDRADB_BOLT_URL": "bolt://127.0.0.1:7687",
    "HYDRADB_HTTP_URL": "http://127.0.0.1:8443",
    "HYDRADB_NAMESPACE": "keto",
    "HYDRADB_GRAPH_ID": "keto",
    "HYDRADB_CELL_ID": "cell-0"
  }
}
